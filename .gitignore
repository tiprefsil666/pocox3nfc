# Local firmware, extracted proprietary Android files, and prebuilt images
/android/
/postmarketos/*.img
/postmarketos/prebuilt/
/postmarketos/decoded-firmware/

# Reverse-engineering workspace: local copies of the proprietary vendor
# binaries themselves, the factory ACDB calibration, and the scratch
# output of the triage tools.  The analysis, the evidence bundle, the
# tools, the reimplementation and the open-source configuration files are
# published; the binaries and the per-device calibration are not.
/.private/
/rea/05-scratch/

# The vendor binaries and the ACDB live outside the tree, in the private
# working copy.  These symlinks point at them for local use only.
/rea/00-inputs/audio
/rea/00-inputs/gnss
/rea/00-inputs/nfc

# Python bytecode and local build output
__pycache__/
*.py[cod]
*.o
*.ko
*.tar.gz

# Build output of the C reimplementation
/rea/03-c-reimplementation/build/

# The build pipeline's working directories. The pmbootstrap work folder
# holds the chroot, the toolchain and the images, and it is tens of
# gigabytes; the pmaports checkout is a large clone.
/build-pmb/
/postmarketos/upstream/
/build/out/
